# ==========================================
# RakshaSphere Environment Configuration Template
# Copy this file to .env before starting the application.
# DO NOT commit the actual .env file with secrets to source control.
# ==========================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
CORS_ORIGIN=http://localhost:5173

# Frontend Configuration (Vite requires VITE_ prefix for exposed env vars)
VITE_API_BASE_URL=http://localhost:5000

# Database Configuration (Optional for development; required for persistent MongoDB)
# For local MongoDB: mongodb://localhost:27017/rakshasphere
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/rakshasphere
MONGODB_URI=mongodb://localhost:27017/rakshasphere

# Authentication & Security Configuration (Phase 7)
# Use secure 32+ character random strings in production
JWT_ACCESS_SECRET=your-secure-access-secret-32-chars-min
JWT_REFRESH_SECRET=your-secure-refresh-secret-32-chars-min
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# Rate Limiting Configuration
RATE_LIMIT_GLOBAL_MAX=300
RATE_LIMIT_AUTH_MAX=15
RATE_LIMIT_ANALYSIS_MAX=20
RATE_LIMIT_UPLOAD_MAX=30
TRUST_PROXY=false

# Optional External AI Provider (Phase 3)
AI_PROVIDER_API_KEY=your-ai-provider-api-key-placeholder
AI_PROVIDER_MODEL=gemini-1.5-flash

# Optional Transactional Email Configuration (Phase F)
# EMAIL_PROVIDER can be: none | smtp | mock (defaults to none)
EMAIL_PROVIDER=none
EMAIL_FROM=no-reply@rakshasphere.org
SMTP_HOST=aaryapawarwork@gmail.com
SMTP_PORT=587
SMTP_USER=smtp-username-placeholder
SMTP_PASS=smtp-password-placeholder
SMTP_SECURE=false
