# ==========================================
# RakshaSphere Environment Configuration Template
# Copy this file to .env before starting the application.
# DO NOT commit the actual .env file with secrets to source control.
# ==========================================

# Backend Server Configuration
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Frontend Configuration (Vite requires VITE_ prefix for exposed env vars)
VITE_API_BASE_URL=http://localhost:5000

# Future Phase Placeholders (Deferred until approved phase)
# MONGODB_URI=mongodb://localhost:27017/rakshasphere
# JWT_SECRET=your-secure-jwt-secret-placeholder
# AI_PROVIDER_API_KEY=your-ai-provider-api-key-placeholder
